# Backend supplies its authorized PostgreSQL connection.
DATABASE_URL=postgresql://pipeline:change-me@localhost:5432/pipeline
DATABASE_SCHEMA=public

# Model is configurable. Confirm availability and free-tier quota in your AI Studio project.
# No paid fallback is implemented. Do not commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=8192
